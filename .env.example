# NestJS
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_ENABLED=true
LOG_LEVEL=info
CORS_ENABLED=true
CORS_ORIGIN=*

# Rate limiting (ThrottlerModule)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Auth interna (JWT emitido por este backend tras login con Supabase)
JWT_ACCESS_TOKEN_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRES_IN=8h
JWT_REFRESH_TOKEN_SECRET=change-me-refresh
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# Supabase Auth (identidad compartida; perfiles en platform_admins / staff_users)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma
# PRISMA_CONNECT_ON_STARTUP=true intenta conectar al arrancar (util en prod)
PRISMA_CONNECT_ON_STARTUP=false

# OpenTelemetry (opcional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sazono-backend-monolith
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_DEBUG=false

# Postgres (Supabase)
# DATABASE_URL: pooler de sesion para la app en runtime
# DIRECT_URL: conexion directa para migraciones Prisma (prisma migrate)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[SESSION_POOLER_HOST]:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Firebase Admin SDK (OPCIONAL - habilita el envio real de push a
# sazono-staff-app cuando nueva orden llega a cocina/barra o un ticket pasa
# a READY). Si estas 3 vacias, FirebaseAdminService queda deshabilitado y
# PushNotificationService no hace nada (no-op silencioso, no rompe el
# arranque ni el build).
# Se obtienen en Firebase Console > Project Settings > Service Accounts >
# Generate new private key (descarga un JSON con estos 3 campos).
# FIREBASE_PRIVATE_KEY debe pegarse con los \n literales tal cual vienen en
# el JSON descargado (entre comillas, en una sola linea).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mercado Pago (OPCIONAL - habilita la conexion de cuentas de pago del
# restaurante via OAuth marketplace no custodial). Si MERCADOPAGO_ENABLED
# esta en false, PaymentAccountsController sigue registrado pero cualquier
# intento de generar una authorization-url falla claro con 503; el arranque
# de la app nunca se rompe. Si MERCADOPAGO_ENABLED=true, las demas variables
# de este bloque (menos MERCADOPAGO_OAUTH_PKCE_ENABLED) son obligatorias y
# el boot falla con un mensaje claro si falta alguna.
# Doc oficial OAuth/Marketplace (creation + PKCE + token endpoint):
# https://www.mercadopago.com.ar/developers/en/docs/security/oauth/creation
# https://www.mercadopago.com.ar/developers/en/reference/authentication/oauth/_oauth_token/post
MERCADOPAGO_ENABLED=false
# MERCADOPAGO_CLIENT_ID / MERCADOPAGO_CLIENT_SECRET: se obtienen en el panel
# de credenciales de la aplicacion Mercado Pago (developers.mercadopago.cl).
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# sandbox (pruebas) o production
MERCADOPAGO_ENVIRONMENT=sandbox
# Debe coincidir EXACTO con el redirect_uri registrado en la aplicacion MP.
# Apunta al callback publico de este backend, no al frontend.
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/payment-accounts/mercado-pago/callback
# URL publica que Mercado Pago llamara con las notificaciones de pago.
# Debe apuntar al tunel HTTPS publico de este backend (no al frontend) y
# coincidir con lo suscrito en el panel de la app MP > Webhooks. Se envia
# tambien como notification_url en cada cobro (ver charge-payment.service.ts).
MERCADOPAGO_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/payments/mercado-pago
# Secreto de firma del webhook (panel de la aplicacion MP > Webhooks >
# Configurar notificacion). Se usa para verificar el header x-signature con
# HMAC-SHA256 antes de confiar en cualquier notificacion entrante.
# Doc oficial (algoritmo de firma + manifest exacto):
# https://www.mercadopago.com.ar/developers/en/docs/your-integrations/notifications/webhooks
MERCADOPAGO_WEBHOOK_SECRET=
# Ventana anti-replay (en segundos) para el ts del header x-signature. Una
# notificacion con un ts mas viejo o mas nuevo que esta tolerancia se
# rechaza aunque la firma sea valida.
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
# true SOLO si la aplicacion MP tiene "Authorization code with PKCE"
# habilitado en su panel de detalles. Con false (default) el flujo OAuth
# funciona igual, sin enviar code_challenge/code_verifier.
MERCADOPAGO_OAUTH_PKCE_ENABLED=false
# Clave AES-256-GCM (32 bytes en base64) para cifrar access_token/
# refresh_token en reposo. Generar con: openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=
# URL del frontend a la que se redirige tras el callback OAuth, con
# ?status=connected|error agregado por el backend. Debe apuntar a la pagina
# real src/app/[locale]/admin/payments de sazono-ui (el proxy de next-intl
# redirige /admin/payments al locale por defecto si se omite el prefijo).
PAYMENTS_OAUTH_UI_RETURN_URL=http://localhost:3001/admin/payments
# Si true, el pago QR exige una cuenta de pago CONNECTED con cardToken
# valido: sin eso el pago se rechaza en vez de registrarse manual.
PAYMENTS_QR_GATEWAY_REQUIRED=false
# Comision de plataforma en basis points (100 = 1%). 0 = sin comision.
# Reservada para el split futuro, todavia no se envia a Mercado Pago.
PAYMENTS_APPLICATION_FEE_BPS=0
# Timeout en milisegundos para las llamadas HTTP al Checkout API de
# Mercado Pago (POST /v1/payments). Doc oficial:
# https://www.mercadopago.com.ar/developers/en/reference/payments/_payments/post
MERCADOPAGO_TIMEOUT_MS=15000

# Transbank Webpay Plus Mall (OPCIONAL - habilita la conexion MANUAL de
# cuentas Transbank del restaurante, sin OAuth: Transbank no lo ofrece, el
# ADMIN ingresa su childCommerceCode directamente). Si TRANSBANK_ENABLED esta
# en false, el arranque de la app nunca se rompe y los endpoints
# payment-accounts/transbank/* fallan claro con 503. Si TRANSBANK_ENABLED=true,
# TRANSBANK_MALL_COMMERCE_CODE, TRANSBANK_API_KEY y TRANSBANK_RETURN_URL son
# obligatorias.
# Doc oficial (API REST + SDK Node + ambientes + codigos de comercio de
# integracion publicos, ya pre-configurados en el SDK como
# IntegrationCommerceCodes.WEBPAY_PLUS_MALL /
# IntegrationCommerceCodes.WEBPAY_PLUS_MALL_CHILD1 e IntegrationApiKeys.WEBPAY):
# https://www.transbankdevelopers.cl/documentacion/webpay-plus
# https://www.transbankdevelopers.cl/referencia/webpay
# https://www.transbankdevelopers.cl/documentacion/como_empezar#ambientes
TRANSBANK_ENABLED=false
# Codigo de comercio Mall (padre) asignado por Transbank a la plataforma
# Sazono. Cada restaurante conecta su propio childCommerceCode (tienda hija)
# por separado via POST payment-accounts/transbank.
TRANSBANK_MALL_COMMERCE_CODE=
# Llave secreta (Api Key Secret) asociada al codigo de comercio Mall.
TRANSBANK_API_KEY=
# integration (pruebas, webpay3gint.transbank.cl) o production
# (webpay3g.transbank.cl)
TRANSBANK_ENVIRONMENT=integration
# URL a la que Transbank redirigira (via POST) al cliente despues de pagar o
# abandonar el formulario Webpay. NO apunta directo a este backend: Transbank
# hace un form-POST real del navegador del cliente, y el endpoint del backend
# (POST /api/v1/payment-accounts/transbank/return) devuelve JSON, no una
# pagina. Debe apuntar a la ruta proxy de sazono-ui
# (app/api/pago/retorno/route.ts), que acepta ese POST, reenvia el navegador
# (303) a la pagina real /[locale]/pago/retorno con los mismos parametros
# como query string, y esa pagina es la que llama al endpoint del backend por
# fetch (paymentAccountsApi.confirmTransbankReturn) para confirmar el pago.
# En local, sazono-ui corre en el puerto 3001 (ver PAYMENTS_OAUTH_UI_RETURN_URL
# arriba); en produccion, usa el dominio publico del frontend.
TRANSBANK_RETURN_URL=http://localhost:3001/api/pago/retorno
# Timeout en milisegundos para las llamadas HTTP al API REST de Transbank
# Webpay (create/commit/status).
TRANSBANK_TIMEOUT_MS=15000
# Transbank no tiene webhooks: si el comensal paga pero nunca vuelve al
# return_url (cierra el navegador, pierde señal), el PaymentAttempt queda
# PENDING para siempre. Este job periodico busca PaymentAttempt con
# provider=TRANSBANK, status=PENDING y providerReference no nulo, con mas de
# TRANSBANK_RECONCILIATION_MIN_AGE_MINUTES de antiguedad, y les pregunta a
# Transbank su estado real (status()) para resolverlos. Solo corre si
# TRANSBANK_ENABLED=true; si esta en false, el job nunca se registra.
# Intervalo en milisegundos entre corridas del job.
TRANSBANK_RECONCILIATION_INTERVAL_MS=300000
# Antiguedad minima (en minutos) que debe tener un PaymentAttempt PENDING
# para que el job intente reconciliarlo. Un valor bajo puede reconciliar
# pagos que el cliente todavia esta completando en la pagina de Transbank.
TRANSBANK_RECONCILIATION_MIN_AGE_MINUTES=10
