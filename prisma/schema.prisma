generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum PlatformAdminStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum StaffUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum BranchRoleStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  ADMIN
  SUPERVISOR
  WAITER
  KITCHEN
  BAR
  CASHIER
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MenuCategoryStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  DISABLED
}

enum TableSessionOpenedBySource {
  QR
  WAITER
  HOST
  CASHIER
}

enum TableSessionStatus {
  OPEN
  PAYMENT_COMPLETED
  CLOSED
  ABANDONED
}

enum MenuItemType {
  FOOD
  DRINK
  DESSERT
  PACKAGED
  SERVICE
}

enum ModifierSelectionType {
  ONE
  MANY
}

enum PreparationStationType {
  KITCHEN
  BAR
  DESSERT
  COFFEE
  OTHER
}

enum PreparationStationStatus {
  ACTIVE
  INACTIVE
}

enum OrderSource {
  QR
  WAITER
  MIXED
}

enum PaymentPolicy {
  PREPAID
  POSTPAID
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  ROUTED
  IN_PREPARATION
  PARTIALLY_READY
  READY
  DELIVERED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum StationTicketStatus {
  PENDING
  IN_PROGRESS
  READY
  CANCELLED
}

enum BillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  ABANDONED
  VOID
}

enum BillItemStatus {
  OPEN
  PAID
  VOID
  REFUNDED
}

enum BillSplitMode {
  BY_ITEM
  BY_AMOUNT
  BY_PERCENTAGE
}

enum BillSplitStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BillSplitParticipantStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  MERCADO_PAGO
  VOUCHER
  MACH
  OTHER
}

enum PaymentAttemptStatus {
  PENDING
  FAILED
  SUCCEEDED
  CANCELLED
}

enum TranslationEntityType {
  MENU
  MENU_CATEGORY
  MENU_ITEM
}

enum LeadIntent {
  DEMO_REQUEST
  GENERAL_INQUIRY
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Restaurant {
  id                   String                         @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String?                        @map("legal_name")
  slug                 String                         @unique
  branchQuota          Int                            @default(1) @map("branch_quota")
  defaultLanguage      String                         @default("es") @map("default_language")
  timezone             String                         @default("America/Santiago")
  currency             String                         @default("CLP")
  status               RestaurantStatus               @default(ACTIVE)
  platformFeeBps       Int                            @default(100) @map("platform_fee_bps")
  taxId                String?                        @map("tax_id")
  businessActivity     String?                        @map("business_activity")
  legalAddress         String?                        @map("legal_address")
  economicActivityCode Int?                           @map("economic_activity_code")
  legalCommune         String?                        @map("legal_commune")
  legalCity            String?                        @map("legal_city")
  taxProviderAccounts  RestaurantTaxProviderAccount[]
  feeStatements        PlatformFeeStatement[]
  taxDocuments         TaxDocument[]
  branches             Branch[]
  staffUsers           StaffUser[]
  paymentAccounts      RestaurantPaymentAccount[]
  paymentOAuthStates   PaymentOAuthState[]
  refunds              Refund[]
  cashSessions         CashSession[]
  billDiscounts        BillDiscount[]
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("restaurants")
}

model Branch {
  id                  String                @id @default(uuid()) @db.Uuid
  restaurantId        String                @map("restaurant_id") @db.Uuid
  name                String
  address             String?
  status              BranchStatus          @default(ACTIVE)
  restaurant          Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  settings            BranchSettings?
  staffUserRoles      StaffUserBranchRole[]
  tables              Table[]
  tableSessions       TableSession[]
  tableZones          TableZone[]
  menus               Menu[]
  preparationStations PreparationStation[]
  orders              Order[]
  bills               Bill[]
  modifierGroups      ModifierGroup[]
  refunds             Refund[]
  cashMovements       CashMovement[]
  cashSessions        CashSession[]
  billDiscounts       BillDiscount[]
  taxDocuments        TaxDocument[]
  printers            Printer[]
  printDevices        PrintDevice[]
  printJobs           PrintJob[]
  billSequence        Int                   @default(0) @map("bill_sequence")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  stationTickets      StationTicket[]

  @@index([restaurantId])
  @@map("branches")
}

model BranchSettings {
  branchId                String   @id @map("branch_id") @db.Uuid
  qrOrderingEnabled       Boolean  @default(true) @map("qr_ordering_enabled")
  qrPaymentMode           String   @default("prepaid_order") @map("qr_payment_mode")
  splitBillEnabled        Boolean  @default(true) @map("split_bill_enabled")
  partialDeliveryEnabled  Boolean  @default(true) @map("partial_delivery_enabled")
  autoDeliverAfterMinutes Int?     @map("auto_deliver_after_minutes")
  tableAssignmentEnabled  Boolean  @default(false) @map("table_assignment_enabled")
  defaultMenuId           String?  @map("default_menu_id") @db.Uuid
  cashierRefundLimit      Decimal? @map("cashier_refund_limit") @db.Decimal(12, 2)
  refundTipDefault        Boolean  @default(false) @map("refund_tip_default")
  discountApprovalPercent Decimal? @default(10) @map("discount_approval_percent") @db.Decimal(5, 2)
  discountApprovalAmount  Decimal? @map("discount_approval_amount") @db.Decimal(12, 2)
  requireOpenCashSession  Boolean  @default(false) @map("require_open_cash_session")
  businessDayStartHour    Int      @default(4) @map("business_day_start_hour")
  branch                  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  defaultMenu             Menu?    @relation("BranchDefaultMenu", fields: [defaultMenuId], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([defaultMenuId])
  @@map("branch_settings")
}

model StaffUser {
  id                        String                @id @default(uuid()) @db.Uuid
  authUserId                String                @map("auth_user_id") @db.Uuid
  restaurantId              String                @map("restaurant_id") @db.Uuid
  firstName                 String                @map("first_name")
  lastName                  String                @map("last_name")
  status                    StaffUserStatus       @default(INVITED)
  pinHash                   String?               @map("pin_hash")
  pinSetAt                  DateTime?             @map("pin_set_at") @db.Timestamptz(3)
  pinFailedAttempts         Int                   @default(0) @map("pin_failed_attempts")
  pinLockedUntil            DateTime?             @map("pin_locked_until") @db.Timestamptz(3)
  approvalPinFailedAttempts Int                   @default(0) @map("approval_pin_failed_attempts")
  approvalPinLockedUntil    DateTime?             @map("approval_pin_locked_until") @db.Timestamptz(3)
  restaurant                Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchRoles               StaffUserBranchRole[]
  openedSessions            TableSession[]        @relation("TableSessionOpenedBy")
  closedSessions            TableSession[]        @relation("TableSessionClosedBy")
  assignedSessions          TableSession[]        @relation("TableSessionAssignedTo")
  zoneMemberships           StaffUserZone[]
  createdOrders             Order[]               @relation("OrderCreatedBy")
  resolvedBills             Bill[]                @relation("BillResolvedBy")
  collectedPayments         Payment[]             @relation("PaymentCollectedBy")
  deviceTokens              StaffDeviceToken[]
  createdPaymentOAuthStates PaymentOAuthState[]
  requestedRefunds          Refund[]              @relation("RefundRequestedBy")
  approvedRefunds           Refund[]              @relation("RefundApprovedBy")
  cashMovements             CashMovement[]
  discountsApplied          BillDiscount[]        @relation("BillDiscountAppliedBy")
  discountsApproved         BillDiscount[]        @relation("BillDiscountApprovedBy")
  discountsVoided           BillDiscount[]        @relation("BillDiscountVoidedBy")
  cashSessionsOpened        CashSession[]         @relation("CashSessionCashier")
  cashSessionsClosed        CashSession[]         @relation("CashSessionClosedBy")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([authUserId, restaurantId])
  @@index([restaurantId])
  @@map("staff_users")
}

model StaffDeviceToken {
  id           String    @id @default(uuid()) @db.Uuid
  staffUserId  String    @map("staff_user_id") @db.Uuid
  fcmToken     String    @map("fcm_token")
  platform     String
  soundEnabled Boolean   @default(true) @map("sound_enabled")
  staffUser    StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime  @updatedAt @map("last_seen_at") @db.Timestamptz(3)

  @@unique([staffUserId, fcmToken])
  @@index([staffUserId])
  @@map("staff_device_tokens")
}

model PlatformAdmin {
  id         String              @id @default(uuid()) @db.Uuid
  authUserId String              @map("auth_user_id") @db.Uuid
  firstName  String              @map("first_name")
  lastName   String              @map("last_name")
  status     PlatformAdminStatus @default(INVITED)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([authUserId])
  @@map("platform_admins")
}

model StaffUserBranchRole {
  id          String           @id @default(uuid()) @db.Uuid
  staffUserId String           @map("staff_user_id") @db.Uuid
  branchId    String           @map("branch_id") @db.Uuid
  role        Role
  status      BranchRoleStatus @default(ACTIVE)
  staffUser   StaffUser        @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([staffUserId, branchId, role])
  @@index([branchId])
  @@map("staff_user_branch_roles")
}

model Table {
  id                String         @id @default(uuid()) @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  code              String
  name              String
  capacity          Int?
  zoneId            String?        @map("zone_id") @db.Uuid
  qrToken           String         @unique @map("qr_token")
  status            TableStatus    @default(AVAILABLE)
  isVirtual         Boolean        @default(false) @map("is_virtual")
  counterLastTicket Int            @default(0) @map("counter_last_ticket")
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zone              TableZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  tableSessions     TableSession[]
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, code])
  @@map("tables")
}

model TableSession {
  id                  String                     @id @default(uuid()) @db.Uuid
  tableId             String                     @map("table_id") @db.Uuid
  branchId            String                     @map("branch_id") @db.Uuid
  status              TableSessionStatus         @default(OPEN)
  openedBySource      TableSessionOpenedBySource @map("opened_by_source")
  openedByStaffUserId String?                    @map("opened_by_staff_user_id") @db.Uuid
  closedByStaffUserId String?                    @map("closed_by_staff_user_id") @db.Uuid
  assignedStaffUserId String?                    @map("assigned_staff_user_id") @db.Uuid
  guestCount          Int?                       @map("guest_count")
  isCounter           Boolean                    @default(false) @map("is_counter")
  ticketNumber        Int?                       @map("ticket_number")
  customerLabel       String?                    @map("customer_label")
  closeReason         String?                    @map("close_reason")
  openedAt            DateTime                   @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt            DateTime?                  @map("closed_at") @db.Timestamptz(3)
  table               Table                      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  branch              Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedByStaffUser   StaffUser?                 @relation("TableSessionOpenedBy", fields: [openedByStaffUserId], references: [id], onDelete: SetNull)
  closedByStaffUser   StaffUser?                 @relation("TableSessionClosedBy", fields: [closedByStaffUserId], references: [id], onDelete: SetNull)
  assignedStaffUser   StaffUser?                 @relation("TableSessionAssignedTo", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  bill                Bill?
  orders              Order[]
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tableId])
  @@index([branchId, status])
  @@map("table_sessions")
}

model TableZone {
  id           String          @id @default(uuid()) @db.Uuid
  branchId     String          @map("branch_id") @db.Uuid
  name         String
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables       Table[]
  staffMembers StaffUserZone[]
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, name])
  @@map("table_zones")
}

model StaffUserZone {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  zoneId      String    @map("zone_id") @db.Uuid
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  zone        TableZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([staffUserId, zoneId])
  @@map("staff_user_zones")
}

model Menu {
  id                    String           @id @default(uuid()) @db.Uuid
  branchId              String           @map("branch_id") @db.Uuid
  name                  String
  status                MenuStatus       @default(DRAFT)
  version               Int              @default(1)
  publishedAt           DateTime?        @map("published_at") @db.Timestamptz(3)
  defaultLanguage       String           @default("es") @map("default_language")
  branch                Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categories            MenuCategory[]
  branchDefaultSettings BranchSettings[] @relation("BranchDefaultMenu")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, version])
  @@index([branchId, status])
  @@map("menus")
}

model MenuCategory {
  id        String             @id @default(uuid()) @db.Uuid
  menuId    String             @map("menu_id") @db.Uuid
  name      String
  sortOrder Int                @default(0) @map("sort_order")
  status    MenuCategoryStatus @default(ACTIVE)
  parentId  String?            @map("parent_id") @db.Uuid
  menu      Menu               @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    MenuCategory?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  MenuCategory[]     @relation("CategoryTree")
  items     MenuItem[]
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([menuId, sortOrder])
  @@index([menuId, parentId, sortOrder])
  @@map("menu_categories")
}

model PreparationStation {
  id             String                   @id @default(uuid()) @db.Uuid
  branchId       String                   @map("branch_id") @db.Uuid
  name           String
  stationType    PreparationStationType   @map("station_type")
  status         PreparationStationStatus @default(ACTIVE)
  branch         Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]
  orderItems     OrderItem[]
  stationTickets StationTicket[]
  printCode      String?                  @map("print_code")
  printers       PrinterStation[]
  ticketCounters PrintTicketCounter[]
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, name])
  @@unique([branchId, printCode])
  @@index([branchId, stationType])
  @@map("preparation_stations")
}

model MenuItem {
  id                   String                  @id @default(uuid()) @db.Uuid
  menuCategoryId       String                  @map("menu_category_id") @db.Uuid
  name                 String
  description          String?
  price                Decimal                 @db.Decimal(12, 2)
  sku                  String?
  itemType             MenuItemType            @map("item_type")
  preparationStationId String                  @map("preparation_station_id") @db.Uuid
  isAvailable          Boolean                 @default(true) @map("is_available")
  sortOrder            Int                     @default(0) @map("sort_order")
  menuCategory         MenuCategory            @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  preparationStation   PreparationStation      @relation(fields: [preparationStationId], references: [id], onDelete: Restrict)
  media                MenuItemMedia[]
  orderItems           OrderItem[]
  modifierGroups       MenuItemModifierGroup[]
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([menuCategoryId, isAvailable])
  @@index([menuCategoryId, sortOrder])
  @@index([preparationStationId])
  @@map("menu_items")
}

model MenuItemMedia {
  id         String   @id @default(uuid()) @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  mediaType  String   @map("media_type")
  url        String
  sortOrder  Int      @default(0) @map("sort_order")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([menuItemId, sortOrder])
  @@map("menu_item_media")
}

model ModifierGroup {
  id             String                  @id @default(uuid()) @db.Uuid
  branchId       String                  @map("branch_id") @db.Uuid
  parentOptionId String?                 @map("parent_option_id") @db.Uuid
  name           String
  selectionType  ModifierSelectionType   @map("selection_type")
  minSelect      Int                     @default(0) @map("min_select")
  maxSelect      Int?                    @map("max_select")
  isRequired     Boolean                 @default(false) @map("is_required")
  sortOrder      Int                     @default(0) @map("sort_order")
  branch         Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentOption   ModifierOption?         @relation("ModifierOptionChildGroups", fields: [parentOptionId], references: [id], onDelete: Cascade)
  options        ModifierOption[]
  menuItems      MenuItemModifierGroup[]
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([branchId])
  @@index([parentOptionId])
  @@map("modifier_groups")
}

model ModifierOption {
  id                 String              @id @default(uuid()) @db.Uuid
  modifierGroupId    String              @map("modifier_group_id") @db.Uuid
  name               String
  priceDelta         Decimal             @default(0) @map("price_delta") @db.Decimal(12, 2)
  isAvailable        Boolean             @default(true) @map("is_available")
  sortOrder          Int                 @default(0) @map("sort_order")
  imageUrl           String?             @map("image_url")
  modifierGroup      ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  childGroups        ModifierGroup[]     @relation("ModifierOptionChildGroups")
  orderItemModifiers OrderItemModifier[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([modifierGroupId, sortOrder])
  @@map("modifier_options")
}

model MenuItemModifierGroup {
  id              String        @id @default(uuid()) @db.Uuid
  menuItemId      String        @map("menu_item_id") @db.Uuid
  modifierGroupId String        @map("modifier_group_id") @db.Uuid
  sortOrder       Int           @default(0) @map("sort_order")
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([menuItemId, modifierGroupId])
  @@index([modifierGroupId])
  @@map("menu_item_modifier_groups")
}

model Translation {
  id              String                @id @default(uuid()) @db.Uuid
  entityType      TranslationEntityType @map("entity_type")
  entityId        String                @map("entity_id") @db.Uuid
  locale          String
  fieldName       String                @map("field_name")
  translatedValue String                @map("translated_value")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([entityType, entityId, locale, fieldName])
  @@map("translations")
}

model Bill {
  id                    String           @id @default(uuid()) @db.Uuid
  tableSessionId        String           @unique @map("table_session_id") @db.Uuid
  branchId              String           @map("branch_id") @db.Uuid
  status                BillStatus       @default(OPEN)
  number                Int?
  subtotalAmount        Decimal          @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  taxAmount             Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  tipAmount             Decimal          @default(0) @map("tip_amount") @db.Decimal(12, 2)
  totalAmount           Decimal          @default(0) @map("total_amount") @db.Decimal(12, 2)
  remainingAmount       Decimal          @default(0) @map("remaining_amount") @db.Decimal(12, 2)
  refundedAmount        Decimal          @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  discountAmount        Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  resolvedByStaffUserId String?          @map("resolved_by_staff_user_id") @db.Uuid
  closeReason           String?          @map("close_reason")
  openedAt              DateTime         @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt              DateTime?        @map("closed_at") @db.Timestamptz(3)
  tableSession          TableSession     @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  branch                Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  resolvedByStaffUser   StaffUser?       @relation("BillResolvedBy", fields: [resolvedByStaffUserId], references: [id], onDelete: SetNull)
  orders                Order[]
  billItems             BillItem[]
  billSplits            BillSplit[]
  payments              Payment[]
  paymentAttempts       PaymentAttempt[]
  refunds               Refund[]
  taxDocuments          TaxDocument[]
