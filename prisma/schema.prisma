  totalAmount         Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
  referenceDocumentId String?           @map("reference_document_id") @db.Uuid
  referenceCode       Int?              @map("reference_code")
  reason              String?
  provider            String?
  providerDocId       String?           @map("provider_doc_id")
  pdfUrl              String?           @map("pdf_url")
  timbre              String?
  siiTrackId          String?           @map("sii_track_id")
  receiverRut         String?           @map("receiver_rut")
  receiverName        String?           @map("receiver_name")
  rawResponse         Json?             @map("raw_response")
  attempts            Int               @default(0)
  nextAttemptAt       DateTime?         @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt       DateTime?         @map("last_attempt_at") @db.Timestamptz(3)
  lastError           String?           @map("last_error")
  requestSnapshot     Json?             @map("request_snapshot")
  idempotencyKey      String?           @map("idempotency_key")
  providerStatus      String?           @map("provider_status")
  xmlUrl              String?           @map("xml_url")
  restaurant          Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch              Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bill                Bill              @relation(fields: [billId], references: [id], onDelete: Restrict)
  refund              Refund?           @relation(fields: [refundId], references: [id], onDelete: Restrict)
  referenceDocument   TaxDocument?      @relation("TaxDocumentReference", fields: [referenceDocumentId], references: [id], onDelete: Restrict)
  referencedBy        TaxDocument[]     @relation("TaxDocumentReference")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, type, folio])
  @@unique([restaurantId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([billId])
  @@index([restaurantId, issuedAt])
  @@map("tax_documents")
}

enum TaxProvider {
  OPENFACTURA
}

enum TaxProviderEnvironment {
  SANDBOX
  PRODUCTION
}

enum TaxProviderAccountStatus {
  ACTIVE
  DISABLED
}

model RestaurantTaxProviderAccount {
  id               String                   @id @default(uuid()) @db.Uuid
  restaurantId     String                   @map("restaurant_id") @db.Uuid
  provider         TaxProvider
  environment      TaxProviderEnvironment
  status           TaxProviderAccountStatus @default(ACTIVE)
  apiKeyCipher     String                   @map("api_key_cipher")
  lastVerifiedAt   DateTime?                @map("last_verified_at") @db.Timestamptz(3)
  lastErrorMessage String?                  @map("last_error_message")
  restaurant       Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, provider, environment])
  @@map("restaurant_tax_provider_accounts")
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum DiscountReason {
  COURTESY
  CUSTOMER_COMPLAINT
  STAFF_MEAL
  PROMOTION
  LOYALTY
  PRICE_ERROR
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model BillDiscount {
  id                    String         @id @default(uuid()) @db.Uuid
  restaurantId          String         @map("restaurant_id") @db.Uuid
  branchId              String         @map("branch_id") @db.Uuid
  billId                String         @map("bill_id") @db.Uuid
  billItemId            String?        @map("bill_item_id") @db.Uuid
  type                  DiscountType
  value                 Decimal        @db.Decimal(12, 2)
  amount                Decimal        @default(0) @db.Decimal(12, 2)
  reasonCode            DiscountReason @map("reason_code")
  reasonText            String         @map("reason_text")
  idempotencyKey        String         @map("idempotency_key")
  requestFingerprint    String?        @map("request_fingerprint")
  appliedByStaffUserId  String         @map("applied_by_staff_user_id") @db.Uuid
  appliedByRole         Role           @map("applied_by_role")
  approvedByStaffUserId String?        @map("approved_by_staff_user_id") @db.Uuid
  voidedAt              DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidedByStaffUserId   String?        @map("voided_by_staff_user_id") @db.Uuid
  voidReason            String?        @map("void_reason")
  restaurant            Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch                Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bill                  Bill           @relation(fields: [billId], references: [id], onDelete: Restrict)
  billItem              BillItem?      @relation(fields: [billItemId], references: [id], onDelete: Restrict)
  appliedBy             StaffUser      @relation("BillDiscountAppliedBy", fields: [appliedByStaffUserId], references: [id], onDelete: Restrict)
  approvedBy            StaffUser?     @relation("BillDiscountApprovedBy", fields: [approvedByStaffUserId], references: [id], onDelete: Restrict)
  voidedBy              StaffUser?     @relation("BillDiscountVoidedBy", fields: [voidedByStaffUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([billId, idempotencyKey])
  @@index([billId])
  @@index([billItemId])
  @@index([branchId, createdAt])
  @@map("bill_discounts")
}

model CashSession {
  id                  String            @id @default(uuid()) @db.Uuid
  restaurantId        String            @map("restaurant_id") @db.Uuid
  branchId            String            @map("branch_id") @db.Uuid
  registerLabel       String            @default("Caja 1") @map("register_label")
  status              CashSessionStatus @default(OPEN)
  cashierStaffUserId  String            @map("cashier_staff_user_id") @db.Uuid
  openedAt            DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  openingFloat        Decimal           @map("opening_float") @db.Decimal(12, 2)
  closedAt            DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedByStaffUserId String?           @map("closed_by_staff_user_id") @db.Uuid
  expectedCash        Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  cashSalesAmount     Decimal?          @map("cash_sales_amount") @db.Decimal(12, 2)
  movementsAmount     Decimal?          @map("movements_amount") @db.Decimal(12, 2)
  countedCash         Decimal?          @map("counted_cash") @db.Decimal(12, 2)
  difference          Decimal?          @db.Decimal(12, 2)
  closingNote         String?           @map("closing_note")
  denominations       Json?
  forced              Boolean           @default(false)
  restaurant          Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch              Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashier             StaffUser         @relation("CashSessionCashier", fields: [cashierStaffUserId], references: [id], onDelete: Restrict)
  closedBy            StaffUser?        @relation("CashSessionClosedBy", fields: [closedByStaffUserId], references: [id], onDelete: Restrict)
  payments            Payment[]
  cashMovements       CashMovement[]
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([branchId, openedAt])
  @@index([cashierStaffUserId, status])
  @@map("cash_sessions")
}

model RefundItem {
  id                   String   @id @default(uuid()) @db.Uuid
  refundId             String   @map("refund_id") @db.Uuid
  billItemId           String   @map("bill_item_id") @db.Uuid
  orderItemId          String?  @map("order_item_id") @db.Uuid
  menuItemId           String?  @map("menu_item_id") @db.Uuid
  preparationStationId String?  @map("preparation_station_id") @db.Uuid
  nameSnapshot         String   @map("name_snapshot")
  categoryPathSnapshot String[] @default([]) @map("category_path_snapshot")
  quantity             Int
  amount               Decimal  @db.Decimal(12, 2)
  kitchenWaste         Boolean  @default(false) @map("kitchen_waste")
  refund               Refund   @relation(fields: [refundId], references: [id], onDelete: Restrict)
  billItem             BillItem @relation(fields: [billItemId], references: [id], onDelete: Restrict)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([refundId, billItemId])
  @@index([billItemId])
  @@index([kitchenWaste, createdAt])
  @@map("refund_items")
}

enum PrinterTransport {
  SIMULATED
  TCP
  APP_BRIDGE
  BROWSER
  AGENT
  CLOUDPRNT
}

enum PrinterStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  ERROR
}

enum PrintJobStatus {
  PENDING
  CLAIMED
  PRINTED
  FAILED
  CANCELLED
}

enum PrintJobKind {
  COMANDA
  VOID
  TEST
}

enum PrintDeviceKind {
  ANDROID_APP
  BROWSER
  AGENT
}

model Printer {
  id        String           @id @default(uuid()) @db.Uuid
  branchId  String           @map("branch_id") @db.Uuid
  name      String
  transport PrinterTransport

  connection     Json                 @default("{}")
  paperWidthMm   Int                  @default(58) @map("paper_width_mm")
  columns        Int                  @default(32)
  codepage       String               @default("cp858")
  escTCodepageId Int?                 @map("esc_t_codepage_id")
  copies         Int                  @default(1)
  autoCut        Boolean              @default(true) @map("auto_cut")
  cashDrawer     Boolean              @default(false) @map("cash_drawer")
  printVoidSlips Boolean              @default(true) @map("print_void_slips")
  active         Boolean              @default(true)
  status         PrinterStatus        @default(UNKNOWN)
  lastSeenAt     DateTime?            @map("last_seen_at") @db.Timestamptz(3)
  lastError      String?              @map("last_error")
  branch         Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stations       PrinterStation[]
  devices        PrintDevicePrinter[]
  jobs           PrintJob[]
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, name])
  @@index([branchId, active])
  @@map("printers")
}

model PrinterStation {
  printerId            String             @map("printer_id") @db.Uuid
  preparationStationId String             @map("preparation_station_id") @db.Uuid
  printer              Printer            @relation(fields: [printerId], references: [id], onDelete: Cascade)
  preparationStation   PreparationStation @relation(fields: [preparationStationId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([printerId, preparationStationId])
  @@index([preparationStationId])
  @@map("printer_stations")
}

model PrintDevice {
  id               String               @id @default(uuid()) @db.Uuid
  branchId         String               @map("branch_id") @db.Uuid
  kind             PrintDeviceKind
  name             String
  tokenHash        String?              @unique @map("token_hash")
  pairingCodeHash  String?              @map("pairing_code_hash")
  pairingExpiresAt DateTime?            @map("pairing_expires_at") @db.Timestamptz(3)
  appVersion       String?              @map("app_version")
  active           Boolean              @default(true)
  lastSeenAt       DateTime?            @map("last_seen_at") @db.Timestamptz(3)
  branch           Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  printers         PrintDevicePrinter[]
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([branchId, active])
  @@map("print_devices")
}

model PrintDevicePrinter {
  deviceId  String      @map("device_id") @db.Uuid
  printerId String      @map("printer_id") @db.Uuid
  device    PrintDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  printer   Printer     @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@id([deviceId, printerId])
  @@index([printerId])
  @@map("print_device_printers")
}

model PrintJob {
  id                String         @id @default(uuid()) @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  printerId         String         @map("printer_id") @db.Uuid
  stationTicketId   String?        @map("station_ticket_id") @db.Uuid
  kind              PrintJobKind   @default(COMANDA)
  status            PrintJobStatus @default(PENDING)
  idempotencyKey    String         @unique @map("idempotency_key")
  reprintOfId       String?        @map("reprint_of_id") @db.Uuid
  document          Json
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedByDeviceId String?        @map("claimed_by_device_id") @db.Uuid
  claimedBy         String?        @map("claimed_by")
  leaseUntil        DateTime?      @map("lease_until") @db.Timestamptz(3)
  printedAt         DateTime?      @map("printed_at") @db.Timestamptz(3)
  duplicateAcks     Int            @default(0) @map("duplicate_acks")
  lastError         String?        @map("last_error")
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  printer           Printer        @relation(fields: [printerId], references: [id], onDelete: Cascade)
  stationTicket     StationTicket? @relation(fields: [stationTicketId], references: [id], onDelete: SetNull)
  reprintOf         PrintJob?      @relation("PrintJobReprint", fields: [reprintOfId], references: [id], onDelete: SetNull)
  reprints          PrintJob[]     @relation("PrintJobReprint")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([printerId, status, nextAttemptAt])
  @@index([branchId, createdAt])
  @@index([stationTicketId])
  @@map("print_jobs")
}

model PrintTicketCounter {
  preparationStationId String             @map("preparation_station_id") @db.Uuid
  businessDate         DateTime           @map("business_date") @db.Date
  lastSeq              Int                @default(0) @map("last_seq")
  preparationStation   PreparationStation @relation(fields: [preparationStationId], references: [id], onDelete: Cascade)

  @@id([preparationStationId, businessDate])
  @@map("print_ticket_counters")
}
